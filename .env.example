# MySQL 8
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=agritrack_db

# MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/
MONGODB_DATABASE=agritrack_nosql

# Generate a long random secret for local development
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
