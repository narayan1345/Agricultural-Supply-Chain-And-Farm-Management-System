digraph AgriTrackSchema {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.4", ranksep="0.55", fontname="Arial", label="AgriTrack Relational Schema", labelloc=t, fontsize=20];
  node [shape=box, style="rounded,filled", fillcolor="#F6FAF7", color="#176B45", fontname="Arial", fontsize=10, margin="0.12,0.08"];
  edge [color="#547564", arrowsize=0.7, fontname="Arial", fontsize=8];
  roles [label="ROLES\nPK role_id\nrole_name UNIQUE"];
  users [label="USERS\nPK user_id\nFK role_id\nemail UNIQUE"];
  farms [label="FARMS\nPK farm_id\nFK owner_id"];
  crops [label="CROPS\nPK crop_id\nFK farm_id"];
  harvests [label="HARVESTS\nPK harvest_id\nFK farm_id, crop_id"];
  suppliers [label="SUPPLIERS\nPK supplier_id\nsupplier_name UNIQUE", fillcolor="#FBF3E5", color="#AD7430"];
  warehouses [label="WAREHOUSES\nPK warehouse_id"];
  inventory [label="INVENTORY\nPK inventory_id\nFK crop_id, warehouse_id\nUNIQUE(crop_id, warehouse_id)"];
  orders [label="ORDERS\nPK order_id\nFK buyer_id"];
  order_items [label="ORDER_ITEMS\nPK order_item_id\nFK order_id, inventory_id\nline_total GENERATED"];
  deliveries [label="DELIVERIES\nPK delivery_id\nFK order_id UNIQUE\ntracking_code UNIQUE"];
  roles -> users [label="role_id"];
  users -> farms [label="owner_id"];
  farms -> crops [label="farm_id"];
  farms -> harvests [label="farm_id"];
  crops -> harvests [label="crop_id"];
  crops -> inventory [label="crop_id"];
  warehouses -> inventory [label="warehouse_id"];
  users -> orders [label="buyer_id"];
  orders -> order_items [label="order_id"];
  inventory -> order_items [label="inventory_id"];
  orders -> deliveries [label="order_id"];
}
